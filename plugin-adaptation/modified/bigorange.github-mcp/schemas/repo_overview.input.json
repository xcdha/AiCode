{
  "type": "object",
  "properties": {
    "repo": {
      "type": "string",
      "description": "仓库全名 owner/repo，例如 octocat/Hello-World。省略则用配置页里的默认仓库。"
    },
    "branch": {
      "type": "string",
      "description": "分支名，省略用默认分支。"
    },
    "fresh": {
      "type": "boolean",
      "description": "true 时跳过缓存。"
    }
  },
  "additionalProperties": false
}